# ==============================
# SITE URLS
# ==============================
SITE_BASE_URL=https://bookmaker.example/ru
SITE_LOGIN_URL=/
SITE_LIVE_URL=/live
SITE_FIFA_URL=/live/fifa/2860561-fc-25-3x3-conference-league
SITE_TABLE_TENNIS_URL=/live/table-tennis

# ==============================
# AUTH
# ==============================
XBET_LOGIN=
XBET_PASSWORD=
# Элемент валюты баланса, подтверждающий авторизацию.
SELECTOR_AUTH_MARKER=.balance__currency
# Точный текст валюты авторизованного аккаунта.
TEXT_AUTH_MARKER=RUB

# ==============================
# MATCH LIST
# ==============================
# Корневой элемент страницы лиги.
SELECTOR_PAGE_BODY=body
# Карточка одного матча в списке.
SELECTOR_GAME_CARD=li.dashboard-champ__game
# Ссылка внутри карточки матча.
SELECTOR_MATCH_LINK=a.dashboard-game-block__link
# XPath от ссылки матча к её карточке.
SELECTOR_MATCH_CARD_ANCESTOR_XPATH="xpath=ancestor::li[contains(concat(' ', normalize-space(@class), ' '), ' dashboard-champ__game ')][1]"
# Название команды в карточке.
SELECTOR_TEAM_NAME=.dashboard-game-team-info__name
# Время матча в карточке.
SELECTOR_MATCH_TIME=.dashboard-game-info__time
# Период матча в карточке.
SELECTOR_MATCH_PERIOD=.dashboard-game-info__period
# Значения общего счёта в карточке.
SELECTOR_SCORE=.ui-game-scores__item--total .ui-game-scores__num
# Контейнер коэффициента в карточке матча.
SELECTOR_MATCH_MARKET=.dashboard-markets__market
# Название исхода внутри коэффициента.
SELECTOR_MARKET_NAME=.ui-market__toggle
# Числовое значение коэффициента.
SELECTOR_MARKET_VALUE=.ui-market__value
# Кнопки раскрытия дополнительных рынков; || задаёт fallback.
SELECTOR_ADDITIONAL_MARKETS=button.dashboard-game__more||button.dashboard-game-more

# ==============================
# SCOREBOARD
# ==============================
# Корневой блок нового live-scoreboard.
SELECTOR_SCOREBOARD=.scoreboard-compact-view-tab-panel__body
# Контейнер команды в scoreboard.
SELECTOR_SCOREBOARD_TEAM=.scoreboard-intro__team
# Текст названия команды.
SELECTOR_SCOREBOARD_TEAM_NAME=.scoreboard-team-name__text
# Счёт первой команды.
SELECTOR_SCOREBOARD_TEAM_1_SCORE=.scoreboard-scores__score:not(.scoreboard-scores__score--team-2)
# Счёт второй команды.
SELECTOR_SCOREBOARD_TEAM_2_SCORE=.scoreboard-scores__score--team-2
# Таймер матча.
SELECTOR_TIMER=.ui-game-timer__label
# Таймер / статус матча.
SELECTOR_SCOREBOARD_TIMER_STATUS=.scoreboard-compact-view-tab-panel__summary .ui-game-timer__label

# ==============================
# MARKETS
# ==============================
# Переключатель фильтра «Голы».
SELECTOR_GOALS_FILTER=.game-toolbar-filter-switch
# XPath от текста «Голы» к переключателю.
SELECTOR_GOALS_FILTER_ANCESTOR_XPATH="xpath=ancestor::div[contains(@class,'game-toolbar-filter-switch')][1]"
# Кнопка открытия / активации поиска рынков.
SELECTOR_MARKET_SEARCH_BUTTON=button.ui-search-default__button
# Поле поиска рынка.
SELECTOR_MARKET_SEARCH=input.ui-search-default__input
# Более строгий вариант поля поиска рынков.
SELECTOR_MARKET_SEARCH_EXACT='input.ui-search-default__input[placeholder="Поиск по рынкам"]'
# Группа рынка (DOM fallback).
SELECTOR_MARKET_GROUP=.game-markets-group
# Заголовок группы рынка (DOM fallback).
SELECTOR_MARKET_GROUP_TITLE=.game-markets-group-header-title
# Кнопка исхода в группе рынка (DOM fallback).
SELECTOR_MARKET_BUTTON=button.game-markets-group__market
# CSS-класс заблокированного коэффициента.
CLASS_MARKET_LOCKED=ui-market--locked
# Canvas с коэффициентами — основной источник машинного зрения.
SELECTOR_MARKET_CANVAS=canvas.market-grid-canvas__canvas
# Текст фильтра голов.
TEXT_GOALS_FILTER=Голы
# Название рынка следующего гола.
TEXT_NEXT_GOAL=Следующий гол
# Строка поиска следующего гола.
TEXT_NEXT_GOAL_SEARCH=следующий гол
# Название рынка тотала.
TEXT_TOTAL_EVEN=Тотал чёт
# Строка поиска тотала.
TEXT_TOTAL_EVEN_SEARCH=тотал чет
# Положительный исход рынка.
TEXT_AFFIRMATIVE_SELECTION=Да
# Рынок ничьей первого тайма.
TEXT_FIRST_HALF_MARKET=1X2. 1-й тайм
# Исход ничьей.
TEXT_DRAW_SELECTION=Ничья
# Ключевые слова диагностического поиска рынка; || задаёт список.
TEXT_MARKET_RESPONSE_KEYWORDS=market||odds||coefficient||event||outcome||goal||гол

# ==============================
# BETSLIP
# ==============================
SELECTOR_BETSLIP=.quick-coupon-main
SELECTOR_BET_ACCOUNT='.quick-coupon-main button[aria-label="Основной (RUB)"]'
SELECTOR_BET_AMOUNT_INPUT='.quick-coupon-main input.ui-number-input__field[placeholder="Введите сумму ставки"]'
SELECTOR_BET_SUBMIT_BUTTON=.quick-coupon-main button.quick-coupon-put-bet-button
TEXT_BET_CONFIRM=Сделать ставку

# ==============================
# LIVE RECOVERY
# ==============================
SELECTOR_LOCKED_BET=.quick-coupon-events-card__lock
SELECTOR_LOCKED_BET_TEXT=.quick-coupon-events-card-lock__text
SELECTOR_REMOVE_BET_BUTTON='.quick-coupon-events-card-lock__remove||button[aria-label="Удалить"]'
TEXT_LOCKED_EVENT=Заблокированное событие

# ==============================
# SUBGAMES / FIRST HALF
# ==============================
SELECTOR_SUBGAME_LIST=.game-sub-games__list
SELECTOR_SUBGAME_ITEM=.game-sub-games__item
SELECTOR_SUBGAME_CAPTION=.ui-caption
CLASS_SELECTED_SUBGAME=game-sub-games__item--is-selected
SELECTOR_SELECTED_SUBGAME='.game-sub-games__item.game-sub-games__item--is-selected||.game-sub-games__item.game-sub-games__item--active||.game-sub-games__item.active||.game-sub-games__item.selected||.game-sub-games__item[aria-selected="true"]'
SELECTOR_PERIOD_SIGNALS='.scoreboard-live__status||[role="tab"][aria-selected="true"]||button[aria-pressed="true"]||.game-sub-games__item--is-selected||.game-toolbar-filter-switch--active||.game-toolbar-filter-switch--is-active||.game-subgames__item--active||.game-tabs__item--active'
SELECTOR_GAME_OVER_PANEL=.game-over-panel-default-message
SELECTOR_GAME_OVER_TITLE=.ui-message-block__title
TEXT_FIRST_HALF_TAB=1-й тайм
TEXT_GAME_OVER=Игра завершена.

# ==============================
# TABLE TENNIS
# ==============================
SELECTOR_LEAGUE_ITEM=.dashboard-champ-item
SELECTOR_LEAGUE_GROUP=.dashboard-champ-group-item
SELECTOR_LEAGUE_LINK_TEMPLATE='.dashboard-champ-item a.dashboard-champ-item-template__link[href*="{table_tennis_path}/"], .dashboard-champ-group-item a.dashboard-champ-item-template__link[href*="{table_tennis_path}/"]'
SELECTOR_LEAGUE_TITLE=.dashboard-champ-item-template-title__title
SELECTOR_LEAGUE_GAMES_COUNT=.dashboard-champ-games-count
SELECTOR_ACCORDION_TRIGGER=.ui-accordion__trigger
SELECTOR_MARKET_CONTENT_ITEM=.game-markets-content__item
SELECTOR_MARKET_GROUP_HEADER=.game-markets-group__header
SELECTOR_MARKET_GROUP_LIST=.game-markets-group__list
SELECTOR_MARKET_GROUP_SELECTION=.game-markets-group__market, .market
SELECTOR_TABLE_MARKET_GROUPS=.game-markets-content__item.game-markets-group||.game-markets-content__item||.game-markets-group
SELECTOR_TABLE_MARKET_TITLES=.game-markets-group-header-title .ui-caption||.game-markets-group-header-title
SELECTOR_TABLE_MARKET_BUTTONS=button.game-markets-group__market||button.market||.game-markets-group__market
TEXT_MAIN_GAME=Основная игра
TEXT_FIRST_PARTY=1-я Партия
TEXT_SECOND_PARTY=2-я Партия
TEXT_PARTY_MARKET_TEMPLATE=1X2. {set}-я Партия
TEXT_PLAYER_ONE_ALIASES=П1||P1||1
TEXT_PLAYER_TWO_ALIASES=П2||P2||2

# ==============================
# BACKEND / FRONTEND PUBLIC URLS
# ==============================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# ==============================
# STRATEGY / BROWSER SETTINGS
# ==============================
XBET_LEAGUE_NAME=FC 25. 3x3. Лига Конференций
MATCH_MONITOR_INTERVAL=2
MATCHES_FRONT_FILE=front/frontend/public/matches.json
TABLE_TENNIS_ODDS_POLL_INTERVAL=1.5
TABLE_TENNIS_MIN_ARB_PERCENT=0.5
BET_MODE=DEMO
SCORE_POLL_INTERVAL=0.20
OCR_MAX_ATTEMPTS=5
OCR_RETRY_DELAY=0.7
OCR_MIN_CONFIDENCE=0.55
TESSERACT_CMD=
