# Diagnostics
backend/diagnostics/canvas/*.png
backend/diagnostics/canvas/latest_analysis.json
backend/diagnostics/canvas/*.json
backend/data/*.jsonl
backend/data/*.sqlite3
backend/data/*.sqlite3-*
$patterns = @(
    "browser_profile/",
    "backend/data/"
)

foreach ($p in $patterns) {
    if (-not (Select-String -Path ".gitignore" -SimpleMatch $p -Quiet -ErrorAction SilentlyContinue)) {
        Add-Content ".gitignore" $p
    }
}
# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Browser / Playwright profile
browser_profile/

# Secrets
# Secrets
.env
.env.*
!.env.example

# Frontend
node_modules/
dist/

# Virtual environments
.venv/
venv/

# Logs
*.log
